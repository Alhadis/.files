.\" -*- nroff -*-
.cp 0
.mso man.local
.
.\" Typeset cross-references using traditional BSD formatting
.ie t .ds MF CW
.el   .ds MF R
.ds doc-Xr-font               \*(MF
.ds doc-topic-identifier-font \*(MF
.ds doc-page-section-font     \*(MF
.
.\" Don't actually italicise pathnames
.if t .ds doc-Pa-font \f(CW
.
.\" Sync man-page protocol format with groff_man(7)
.nr doc*Xr-URL-format \n[an*MR-URL-format]
